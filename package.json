{
  "name": "words",
  "version": "0.2.0",
  "type": "module",
  "description": "A local-first journaling companion that listens, never judges, and quietly gets to know you over time.",
  "main": "./out/main/index.js",
  "author": "words",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:memory": "node scripts/test-memory.mjs",
    "eval:mirror": "node scripts/eval-mirror.mjs",
    "test:memory:model": "node scripts/test-memory.mjs --model",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:patterns": "node scripts/test-patterns.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:letters": "node scripts/test-letters.mjs",
    "test:release": "npm run build && electron scripts/smoke-release.mjs",
    "test:philosophy": "node scripts/verify-philosophy.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "node-llama-cpp": "^3.20.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.words.journal",
    "productName": "Words",
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-llama-cpp/**"
    ],
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      }
    ]
  }
}
